# eFootball Academy — mandatory environment variables.
# Copy to .env and fill with real values.
#
# The app builds and runs without this variable: it constructs the
# Prisma client lazily, and every database-dependent page shows an
# explicit "content unavailable" state while the database is missing
# or unreachable. No sample content is ever loaded in that state.
#
# Local / Hostinger shared hosting (MySQL only — MariaDB under the hood).
#   host:     localhost when the app runs on the same server as the database
#   port:     3306
#   user:     the MySQL user created in hPanel (Databases -> MySQL)
#   password: the database user password
#   database: the database name shown in hPanel
#
# Example (Hostinger):  mysql://u123456_efa:YourStrongPass@localhost:3306/u123456_efa
DATABASE_URL="mysql://root:password@localhost:3306/efootball_academy"

# Admin auth (Phase 6) — signs the admin session cookie.
# Required for signing in to /admin. Generate e.g. with: openssl rand -hex 32
AUTH_SECRET=""

# Seed-only account for the admin area: run `npm run db:seed` on the
# server to create the first owner. Empty/unset = admin seeding skipped.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="replace-with-a-strong-password"

# Not used yet — reserved for a later phase (Prisma Studio / future services).
# STUDIO_URL=""