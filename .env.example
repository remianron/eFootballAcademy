# eFootball Academy — mandatory environment variables.
# Copy to .env and fill with real values.
#
# The app builds and runs without this variable: it constructs the
# Prisma client lazily, and every database-dependent page shows an
# explicit "content unavailable" state while the database is missing
# or unreachable. No sample content is ever loaded in that state.
#
# PostgreSQL on Neon (Vercel runtime).
# Two connections are intentionally separate:
#   DATABASE_URL = Neon POOLED connection string (runtime application
#                  queries). Hostname contains "-pooler". Add
#                  ?sslmode=require. Do NOT add ?pgbouncer=true (Neon
#                  runs PgBouncer >= 1.21).
#   DIRECT_URL   = Neon DIRECT connection string (Prisma CLI only:
#                  migrations, db seed, studio). No "-pooler" suffix.
#
# Example:
#   DATABASE_URL="postgresql://user:password@ep-xxx-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://user:password@ep-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""
DIRECT_URL=""

# Admin auth (Phase 6) — signs the admin session cookie.
# Required for signing in to /admin. Generate e.g. with: openssl rand -hex 32
AUTH_SECRET=""

# Seed-only account for the admin area: run `npm run db:seed` on the
# server to create the first owner. Empty/unset = admin seeding skipped.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="replace-with-a-strong-password"

# Not used yet — reserved for a later phase (Prisma Studio / future services).
# STUDIO_URL=""

# ---------------------------------------------------------------------------
# Advertising (Phase: branding). Fully OPTIONAL — the site ships with ads
# DISABLED and works without any of these variables.
#
# AD_PROVIDER controls which advertising provider is active:
#   none      (default) — ads disabled. No third-party script is ever loaded.
#   adsense   — Google AdSense auto-rendered units (see AD_ADSENSE_CLIENT).
#   monetag   — Monetag script wrapper (see AD_MONETAG_SCRIPT_URL).
#
# These values are visible in the public HTML by design (ad IDs are public).
# Leave unset to keep ads disabled. Placeholder values render nothing.
#
# AD_PROVIDER="none"
# AD_ADSENSE_CLIENT="ca-pub-0000000000000000"
# AD_MONETAG_SCRIPT_URL=""
#
# Development only: set to "true" to render placeholder frames instead of
# real ad units (useful when tuning slot placement locally).
# AD_DEBUG="true"